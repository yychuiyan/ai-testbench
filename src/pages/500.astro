---
import Base from '../layouts/Base.astro';

const message =
  Astro.props.error instanceof Error
    ? Astro.props.error.message
    : typeof Astro.props.error === 'string'
      ? Astro.props.error
      : '服务暂时不可用，请稍后重试。';

const isDev = import.meta.env.DEV;
---

<Base title="出错了 · TestBench">
  <div class="min-h-[70vh] flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-lg rounded-2xl border border-stone-200 bg-white shadow-sm px-8 py-10 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-red-50 text-red-600 flex items-center justify-center text-xl font-semibold">
        !
      </div>
      <h1 class="mt-5 text-xl font-semibold text-stone-900">页面出错了</h1>
      <p class="mt-3 text-sm text-stone-500 leading-6">
        可能是内容格式不完整（例如知识库 Markdown 缺少 title / category），或临时服务异常。
      </p>
      {isDev ? (
        <pre class="mt-5 text-left text-xs text-stone-600 bg-stone-50 border border-stone-100 rounded-xl px-4 py-3 overflow-auto max-h-48 whitespace-pre-wrap break-words">
            {message}
          </pre>
      ) : null}
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={import.meta.env.BASE_URL || '/'}
          class="inline-flex h-10 items-center px-4 rounded-lg text-sm font-medium text-white bg-[#4176e6] hover:bg-[#3565c7]"
        >
          返回工作台
        </a>
        <button
          type="button"
          class="inline-flex h-10 items-center px-4 rounded-lg text-sm text-stone-600 border border-stone-200 hover:bg-stone-50"
          onclick="location.reload()"
        >
          刷新页面
        </button>
      </div>
    </div>
  </div>
</Base>
