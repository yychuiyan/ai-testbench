---
import Base from '../../layouts/Base.astro';
import CaseGenerateApp from '../../components/islands/CaseGenerateApp';
---

<Base title="用例生成 · Lantern Harness">
  <div class="max-w-4xl mx-auto px-8 py-8">
    <header class="mb-6">
      <h1 class="text-2xl font-bold text-stone-900">用例生成</h1>
      <p class="mt-2 text-sm text-stone-500">
        选择用例类型、需求与模板后，以会话方式生成用例；结果按所选格式写入
        <code class="text-stone-600">cases/</code>
        对应目录（需 <code class="text-stone-600">npm run dev</code>）。
      </p>
    </header>
    <CaseGenerateApp client:only="react" />
  </div>
</Base>
