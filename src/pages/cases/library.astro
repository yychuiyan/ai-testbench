---
import Base from '../../layouts/Base.astro';
import CasesLibrary from '../../components/islands/CasesLibrary';
---

<Base title="用例管理 · TestBench">
  <div class="max-w-6xl mx-auto px-8 py-8">
    <header class="mb-6">
      <h1 class="text-2xl font-bold text-stone-900">用例管理</h1>
      <p class="mt-2 text-sm text-stone-500">
        平铺浏览本机
        <code class="text-stone-600">cases/</code>
        根目录及子目录中的用例文件（列表不按文件夹分组）；双击本地打开，支持批量删除与「在会话中打开」。
      </p>
    </header>
    <CasesLibrary client:only="react" />
  </div>
</Base>
