---
import Base from '../layouts/Base.astro';
import ChatApp from '../components/islands/ChatApp';
import { getCollection } from 'astro:content';
import { buildSlashDocs } from '../lib/slash-docs';

const knowledge = await getCollection('knowledge');
const templates = await getCollection('templates');
const slashDocs = buildSlashDocs(knowledge, templates);
---

<Base title="我的工作台 · TestBench">
  <div class="h-screen flex flex-col overflow-hidden">
    <div class="flex-1 min-h-0">
      <ChatApp client:only="react" slashDocs={slashDocs} />
    </div>
  </div>
</Base>
