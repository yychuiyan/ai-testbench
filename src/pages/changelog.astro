---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
const md = readFileSync(path.join(root, 'CHANGELOG.md'), 'utf8');

/** 去掉首个 H1，页眉单独渲染 */
const bodyMd = md.replace(/^#\s+[^\n]+\n+/, '');
const introMatch = bodyMd.match(/^([\s\S]*?)(?=\n##\s|$)/);
const introMd = (introMatch?.[1] ?? '').trim();
const versionsMd = bodyMd.slice(introMatch?.[0]?.length ?? 0).trim();

const introHtml = introMd ? (marked.parse(introMd, { async: false }) as string) : '';
const versionsHtml = versionsMd ? (marked.parse(versionsMd, { async: false }) as string) : '';
---

<Base title="变更日志 · TestBench">
  <div class="tw-changelog">
    <header class="tw-changelog-hero">
      <p class="tw-changelog-eyebrow">ai-testbench</p>
      <h1 class="tw-changelog-title" data-i18n="nav.changelog">变更日志</h1>
      {
        introHtml ? (
          <div class="tw-changelog-intro" set:html={introHtml} />
        ) : (
          <p class="tw-changelog-lead">记录 ai-testbench 的版本演进与重要变更。</p>
        )
      }
    </header>

    <div class="tw-changelog-panel">
      <article class="tw-changelog-body" set:html={versionsHtml} />
    </div>
  </div>
</Base>

<style>
  .tw-changelog {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }

  .tw-changelog-hero {
    margin-bottom: 1.75rem;
  }

  .tw-changelog-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tw-accent);
  }

  .tw-changelog-title {
    margin: 0.35rem 0 0;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--tw-label-primary);
  }

  .tw-changelog-lead,
  .tw-changelog-intro {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--tw-label-secondary);
  }

  .tw-changelog-intro :global(p) {
    margin: 0.55rem 0 0;
  }

  .tw-changelog-intro :global(p:first-child) {
    margin-top: 0;
  }

  .tw-changelog-intro :global(h3) {
    margin: 1.15rem 0 0.4rem;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--tw-label-primary);
  }

  .tw-changelog-intro :global(a) {
    color: var(--tw-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--tw-accent) 35%, transparent);
  }

  .tw-changelog-intro :global(a:hover) {
    border-bottom-color: var(--tw-accent);
  }

  .tw-changelog-intro :global(pre) {
    margin: 0.65rem 0 0.85rem;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--tw-border);
    background: color-mix(in srgb, var(--tw-surface-rail-solid) 72%, var(--tw-surface-panel));
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .tw-changelog-intro :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
  }

  .tw-changelog-intro :global(pre code) {
    font-size: inherit;
    padding: 0;
    background: none;
    color: var(--tw-label-primary);
  }

  .tw-changelog-intro :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--tw-accent-soft);
    color: var(--tw-accent);
  }

  .tw-changelog-panel {
    background: var(--tw-surface-panel);
    border: 1px solid var(--tw-border);
    border-radius: 14px;
    padding: 1.5rem 1.75rem 1.25rem;
    box-shadow: 0 1px 0 rgba(16, 24, 40, 0.02);
  }

  .tw-changelog-body :global(h2) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin: 1.75rem 0 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--tw-border);
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--tw-label-primary);
  }

  .tw-changelog-body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .tw-changelog-body :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .tw-changelog-body :global(h2 a:hover) {
    color: var(--tw-accent);
  }

  .tw-changelog-body :global(h3) {
    margin: 1rem 0 0.4rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tw-accent);
  }

  .tw-changelog-body :global(ul) {
    margin: 0.35rem 0 0.75rem;
    padding-left: 1.15rem;
    color: var(--tw-label-secondary);
  }

  .tw-changelog-body :global(li) {
    margin: 0.35rem 0;
    line-height: 1.6;
  }

  .tw-changelog-body :global(li::marker) {
    color: color-mix(in srgb, var(--tw-accent) 70%, var(--tw-label-tertiary));
  }

  .tw-changelog-body :global(p) {
    margin: 0.5rem 0;
    color: var(--tw-label-secondary);
    line-height: 1.65;
  }

  .tw-changelog-body :global(a) {
    color: var(--tw-accent);
    text-decoration: none;
  }

  .tw-changelog-body :global(a:hover) {
    text-decoration: underline;
  }

  .tw-changelog-body :global(code) {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--tw-accent-soft);
    color: var(--tw-accent);
  }
</style>
