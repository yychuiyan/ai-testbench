---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
const md = readFileSync(path.join(root, 'CHANGELOG.md'), 'utf8');

/** 去掉首个 H1，页眉单独渲染 */
const bodyMd = md.replace(/^#\s+[^\n]+\n+/, '');
const introMatch = bodyMd.match(/^([\s\S]*?)(?=\n##\s|$)/);
const introMd = (introMatch?.[1] ?? '').trim();
const versionsMd = bodyMd.slice(introMatch?.[0]?.length ?? 0).trim();

/** 外链在新窗口打开（留言板、操作手册等） */
function withBlankExternalLinks(html: string): string {
  return html.replace(
    /<a\s+([^>]*?)href="(https?:\/\/[^"]+)"([^>]*)>/gi,
    (_m, pre: string, href: string, post: string) => {
      const attrs = `${pre} ${post}`;
      const hasTarget = /\btarget=/i.test(attrs);
      const hasRel = /\brel=/i.test(attrs);
      return `<a ${pre}href="${href}"${post}${hasTarget ? '' : ' target="_blank"'}${
        hasRel ? '' : ' rel="noopener noreferrer"'
      }>`;
    },
  );
}

const introHtml = introMd
  ? withBlankExternalLinks(marked.parse(introMd, { async: false }) as string)
  : '';

type VersionBlock = {
  titleHtml: string;
  summaryHtml: string;
  detailHtml: string;
  hasDetail: boolean;
};

/** 按 ## 版本块拆分：标题 + 首段摘要默认展示，其余折叠 */
function splitVersionBlocks(src: string): VersionBlock[] {
  if (!src.trim()) return [];
  const chunks = src.split(/(?=^##\s)/m).filter((c) => c.trim());
  return chunks.map((chunk) => {
    const lines = chunk.replace(/\r\n/g, '\n').split('\n');
    const titleLine = lines[0] ?? '';
    const rest = lines.slice(1);
    let i = 0;
    while (i < rest.length && !rest[i]!.trim()) i++;
    const summaryLines: string[] = [];
    if (i < rest.length && !rest[i]!.startsWith('#')) {
      while (i < rest.length && rest[i]!.trim() && !rest[i]!.startsWith('#')) {
        summaryLines.push(rest[i]!);
        i++;
      }
    }
    while (i < rest.length && !rest[i]!.trim()) i++;
    const detailMd = rest.slice(i).join('\n').trim();
    const titleHtml = marked.parse(titleLine, { async: false }) as string;
    const summaryHtml = summaryLines.length
      ? (marked.parse(summaryLines.join('\n'), { async: false }) as string)
      : '';
    const detailHtml = detailMd ? (marked.parse(detailMd, { async: false }) as string) : '';
    return {
      titleHtml,
      summaryHtml,
      detailHtml,
      hasDetail: Boolean(detailHtml),
    };
  });
}

const versions = splitVersionBlocks(versionsMd);
---

<Base title="变更日志 · TestBench">
  <div class="tw-changelog">
    <header class="tw-changelog-hero">
      <p class="tw-changelog-eyebrow">ai-testbench</p>
      <h1 class="tw-changelog-title" data-i18n="nav.changelog">变更日志</h1>
      {
        introHtml ? (
          <div class="tw-changelog-intro" set:html={introHtml} />
        ) : (
          <p class="tw-changelog-lead">记录 ai-testbench 的版本演进与重要变更。</p>
        )
      }
    </header>

    <div class="tw-changelog-list tw-anim-list">
      {
        versions.map((v) => (
          <section class="tw-changelog-card" data-open="false">
            <div class="tw-changelog-card-head" set:html={v.titleHtml} />
            {v.summaryHtml ? (
              <div class="tw-changelog-card-summary" set:html={v.summaryHtml} />
            ) : null}
            {v.hasDetail ? (
              <>
                <div class="tw-changelog-card-detail-wrap">
                  <div class="tw-changelog-card-detail" set:html={v.detailHtml} />
                </div>
                <div class="tw-changelog-toggle-row">
                  <button
                    type="button"
                    class="tw-changelog-toggle"
                    aria-expanded="false"
                  >
                    <span class="tw-changelog-toggle-label">查看更多</span>
                    <svg
                      class="tw-changelog-toggle-arrow"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6 3.5 L10.5 8 L6 12.5"></path>
                    </svg>
                  </button>
                </div>
              </>
            ) : null}
          </section>
        ))
      }
    </div>
  </div>

  <script>
    document.querySelectorAll('.tw-changelog-card').forEach((card) => {
      const btn = card.querySelector('.tw-changelog-toggle');
      const label = card.querySelector('.tw-changelog-toggle-label');
      if (!(btn instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) return;

      btn.addEventListener('click', () => {
        const next = card.getAttribute('data-open') !== 'true';
        card.setAttribute('data-open', next ? 'true' : 'false');
        btn.setAttribute('aria-expanded', next ? 'true' : 'false');
        label.textContent = next ? '收起' : '查看更多';
      });
    });
  </script>
</Base>

<style>
  .tw-changelog {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }

  .tw-changelog-hero {
    margin-bottom: 1.75rem;
  }

  .tw-changelog-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tw-accent);
  }

  .tw-changelog-title {
    margin: 0.35rem 0 0;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--tw-label-primary);
  }

  .tw-changelog-lead,
  .tw-changelog-intro {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--tw-label-secondary);
  }

  .tw-changelog-intro :global(p) {
    margin: 0.55rem 0 0;
  }

  .tw-changelog-intro :global(p:first-child) {
    margin-top: 0;
  }

  .tw-changelog-intro :global(h3) {
    margin: 1.15rem 0 0.4rem;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--tw-label-primary);
  }

  .tw-changelog-intro :global(a) {
    color: var(--tw-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--tw-accent) 35%, transparent);
  }

  .tw-changelog-intro :global(a:hover) {
    border-bottom-color: var(--tw-accent);
  }

  .tw-changelog-intro :global(pre) {
    margin: 0.65rem 0 0.85rem;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--tw-border);
    background: color-mix(in srgb, var(--tw-surface-rail-solid) 72%, var(--tw-surface-panel));
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .tw-changelog-intro :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
  }

  .tw-changelog-intro :global(pre code) {
    font-size: inherit;
    padding: 0;
    background: none;
    color: var(--tw-label-primary);
  }

  .tw-changelog-intro :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--tw-accent-soft);
    color: var(--tw-accent);
  }

  .tw-changelog-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tw-changelog-card {
    background: var(--tw-surface-panel);
    border: 1px solid var(--tw-border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem 1rem;
    box-shadow: 0 1px 0 rgba(16, 24, 40, 0.02);
  }

  .tw-changelog-card-head :global(h2) {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--tw-label-primary);
  }

  .tw-changelog-card-head :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .tw-changelog-card-head :global(h2 a:hover) {
    color: var(--tw-accent);
  }

  .tw-changelog-card-summary :global(p) {
    margin: 0.65rem 0 0;
    color: var(--tw-label-secondary);
    line-height: 1.65;
    font-size: 0.9375rem;
  }

  .tw-changelog-card-detail-wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0;
    transition:
      grid-template-rows 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.24s ease,
      margin-top 0.32s ease;
  }

  .tw-changelog-card[data-open='true'] .tw-changelog-card-detail-wrap {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.35rem;
  }

  .tw-changelog-card-detail {
    overflow: hidden;
    min-height: 0;
  }

  .tw-changelog-card-detail :global(h3) {
    margin: 1rem 0 0.4rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tw-accent);
  }

  .tw-changelog-card-detail :global(h4) {
    margin: 0.85rem 0 0.35rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--tw-label-primary);
  }

  .tw-changelog-card-detail :global(ul) {
    margin: 0.35rem 0 0.75rem;
    padding-left: 1.15rem;
    color: var(--tw-label-secondary);
  }

  .tw-changelog-card-detail :global(li) {
    margin: 0.35rem 0;
    line-height: 1.6;
  }

  .tw-changelog-card-detail :global(li::marker) {
    color: color-mix(in srgb, var(--tw-accent) 70%, var(--tw-label-tertiary));
  }

  .tw-changelog-card-detail :global(p) {
    margin: 0.5rem 0;
    color: var(--tw-label-secondary);
    line-height: 1.65;
  }

  .tw-changelog-card-detail :global(a) {
    color: var(--tw-accent);
    text-decoration: none;
  }

  .tw-changelog-card-detail :global(a:hover) {
    text-decoration: underline;
  }

  .tw-changelog-card-detail :global(code) {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--tw-accent-soft);
    color: var(--tw-accent);
  }

  .tw-changelog-toggle-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.65rem;
  }

  .tw-changelog-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0;
    border: none;
    background: none;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--tw-accent);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .tw-changelog-toggle:hover {
    opacity: 0.88;
  }

  .tw-changelog-toggle:hover .tw-changelog-toggle-label {
    text-decoration: underline;
  }

  .tw-changelog-toggle-arrow {
    display: block;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tw-changelog-card[data-open='true'] .tw-changelog-toggle-arrow {
    transform: rotate(90deg);
  }
</style>
